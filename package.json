{
  "name": "www-jeffripke-com",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio for Jeff Ripke. React, Node.js, and PostgreSQL on Heroku.",
  "main": "server/index.js",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -k \"node --watch server/index.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "heroku-postbuild": "npm install --prefix client --include=dev && npm run build --prefix client"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
